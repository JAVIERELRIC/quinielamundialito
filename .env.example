# Supabase — consigue estas en https://supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxx

# NextAuth — genera un secreto aleatorio en: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=tu_secreto_aleatorio_aqui
NEXTAUTH_URL=https://tu-dominio.com

# Resend — consigue tu API key en https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=quiniela@tu-dominio.com

# Email del admin (tú)
ADMIN_EMAIL=tu@email.com
